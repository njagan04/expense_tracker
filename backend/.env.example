# Copy to .env for dev; add the same keys in Vercel > Settings > Environment Variables for prod.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Generate these two with: npm run setup
ENCRYPTION_KEY=
SESSION_SECRET=
# Invite code friends type when they create an account. Empty = sign-up closed.
SIGNUP_CODE=
